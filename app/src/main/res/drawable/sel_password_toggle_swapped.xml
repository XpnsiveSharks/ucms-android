<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- SWAPPED: Show eye-off when hidden, and eye when visible -->
    <!-- Usually: checked=true (visible) -> show eye-off -->
    <!-- Swapped: checked=true (visible) -> show eye -->
    <item android:drawable="@drawable/ic_visibility" android:state_checked="true" />
    <item android:drawable="@drawable/ic_visibility_off" />
</selector>