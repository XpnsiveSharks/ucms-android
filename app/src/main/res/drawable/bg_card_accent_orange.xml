<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Soft Shadow Layer -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#0D000000" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <!-- Orange Shape (Bottom Layer) -->
    <item
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/colorOrange" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <!-- Surface Shape (Top Layer) -->
    <item
        android:left="10dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorRecentCardBg" />
            <corners android:radius="24dp" />
        </shape>
    </item>

</layer-list>
