<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- When password IS visible, show the eye-off icon (to hide it) -->
    <item android:drawable="@drawable/ic_visibility_off" android:state_checked="true" />
    <!-- When password IS NOT visible, show the eye icon (to show it) -->
    <item android:drawable="@drawable/ic_visibility" />
</selector>