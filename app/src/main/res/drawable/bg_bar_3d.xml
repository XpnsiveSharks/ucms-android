<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base Color Layer (Tinted from code) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <corners android:radius="2dp" />
        </shape>
    </item>

    <!-- Side Shadow (Right side darkened) -->
    <item android:left="24dp">
        <shape android:shape="rectangle">
            <solid android:color="#33000000" />
            <corners android:topRightRadius="2dp" android:bottomRightRadius="2dp" />
        </shape>
    </item>

    <!-- Top Highlight -->
    <item android:gravity="top" android:height="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#44FFFFFF" />
            <corners android:topLeftRadius="2dp" android:topRightRadius="2dp" />
        </shape>
    </item>
</layer-list>
