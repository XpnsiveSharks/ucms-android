<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorSurface">

    <!-- Loading -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:visibility="visible" />

    <!-- Error State -->
    <LinearLayout
        android:id="@+id/layoutError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Failed to load ticket"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="@color/colorTextPrimary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetry"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Retry"
            android:textAllCaps="false"
            app:cornerRadius="50dp"
            app:strokeColor="@color/colorPrimary" />

    </LinearLayout>

    <!-- Content -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorSurface"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Top bar -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/screen_padding">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="8dp"
                        android:src="@drawable/ic_arrow_back"
                        android:contentDescription="@string/back" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvTicketNumber"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textColor="@color/colorTextPrimary"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toTopOf="@id/tvCategoryName"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/btnBack"
                    app:layout_constraintTop_toTopOf="@id/btnBack"
                    tools:text="Ticket #10149" />

                <TextView
                    android:id="@+id/tvCategoryName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="@color/colorTextSecondary"
                    app:layout_constraintBottom_toBottomOf="@id/btnBack"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/btnBack"
                    app:layout_constraintTop_toBottomOf="@id/tvTicketNumber"
                    tools:text="Academic Department" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Ticket content card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_padding"
                android:layout_marginBottom="@dimen/spacing_medium"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/corner_radius_card"
                app:cardElevation="2dp"
                app:strokeColor="@color/colorDivider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_medium">

                    <!-- Title -->
                    <TextView
                        android:id="@+id/tvTicketTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="@color/colorTextPrimary"
                        android:textStyle="bold"
                        tools:text="Issue with Subject Pre-requisites" />

                    <!-- Description -->
                    <TextView
                        android:id="@+id/tvDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="@color/colorTextSecondary"
                        tools:text="The course registration system is incorrectly blocking students..." />

                    <!-- Attachment card inside content -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cvAttachment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:visibility="visible"
                        app:cardBackgroundColor="@color/colorBackground"
                        app:cardCornerRadius="@dimen/corner_radius_card"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/colorDivider"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_small">

                            <com.facebook.shimmer.ShimmerFrameLayout
                                android:id="@+id/shimmerAttachment"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:visibility="visible">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <View
                                        android:layout_width="32dp"
                                        android:layout_height="32dp"
                                        android:background="#E0E0E0" />

                                    <View
                                        android:layout_width="100dp"
                                        android:layout_height="10dp"
                                        android:layout_marginStart="@dimen/spacing_small"
                                        android:background="#E0E0E0" />

                                </LinearLayout>

                            </com.facebook.shimmer.ShimmerFrameLayout>

                            <LinearLayout
                                android:id="@+id/layoutAttachmentContent"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:visibility="gone">

                                <ImageView
                                    android:id="@+id/ivAttachmentPreview"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:contentDescription="@string/attachment_preview"
                                    android:src="@drawable/ic_attachment" />

                                <TextView
                                    android:id="@+id/tvAttachmentName"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/spacing_small"
                                    android:layout_weight="1"
                                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                                    android:textColor="@color/colorTextPrimary"
                                    tools:text="screenshot.jpg" />

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:src="@drawable/ic_arrow_drop_down"
                                    android:rotation="-90"
                                    android:contentDescription="@null"
                                    app:tint="@color/colorTextSecondary" />

                            </LinearLayout>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Tracking Timeline section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_padding"
                android:layout_marginBottom="@dimen/spacing_small"
                android:text="TRACKING TIMELINE"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="@color/colorTextSecondary"
                android:letterSpacing="0.1" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTimeline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_padding"
                android:layout_marginBottom="@dimen/spacing_large"
                android:nestedScrollingEnabled="false"
                tools:itemCount="3"
                tools:listitem="@layout/item_timeline_event" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCloseTicket"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_padding"
                android:layout_marginBottom="@dimen/spacing_large"
                android:text="@string/close_ticket"
                android:textAllCaps="false"
                android:visibility="gone"
                app:backgroundTint="@color/colorPrimary"
                app:cornerRadius="@dimen/corner_radius_button" />

        </LinearLayout>

    </ScrollView>

</FrameLayout>
