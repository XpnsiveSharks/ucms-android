<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="@drawable/bg_grid">

    <!-- Header Skeleton -->
    <View
        android:id="@+id/skeletonAvatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="#E0E0E0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/skeletonUserName"
        android:layout_width="160dp"
        android:layout_height="24dp"
        android:layout_marginStart="16dp"
        android:background="#E0E0E0"
        app:layout_constraintBottom_toBottomOf="@id/skeletonAvatar"
        app:layout_constraintStart_toEndOf="@id/skeletonAvatar"
        app:layout_constraintTop_toTopOf="@id/skeletonAvatar" />

    <View
        android:id="@+id/skeletonNotification"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="#E0E0E0"
        app:layout_constraintBottom_toBottomOf="@id/skeletonAvatar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/skeletonAvatar" />

    <!-- Total Tickets Card Skeleton -->
    <View
        android:id="@+id/skeletonTotalTicketsCard"
        android:layout_width="0dp"
        android:layout_height="110dp"
        android:layout_marginTop="32dp"
        android:background="#E0E0E0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/skeletonAvatar" />

    <!-- Stats Row Skeleton (2 cards) -->
    <View
        android:id="@+id/skeletonStats1"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="6dp"
        android:background="#E0E0E0"
        app:layout_constraintEnd_toStartOf="@+id/skeletonStats2"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/skeletonTotalTicketsCard" />

    <View
        android:id="@+id/skeletonStats2"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="6dp"
        android:background="#E0E0E0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/skeletonStats1"
        app:layout_constraintTop_toBottomOf="@id/skeletonTotalTicketsCard" />

    <!-- Action Button / Section Skeleton -->
    <View
        android:id="@+id/skeletonActionArea"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginTop="24dp"
        android:background="#E0E0E0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/skeletonStats1" />

    <!-- Recent Logs Header Skeleton -->
    <View
        android:id="@+id/skeletonRecentHeader"
        android:layout_width="120dp"
        android:layout_height="16dp"
        android:layout_marginTop="32dp"
        android:background="#E0E0E0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/skeletonActionArea" />

    <!-- Ticket List Skeleton -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/skeletonRecentHeader">
        <include layout="@layout/layout_skeleton_ticket" />
        <include layout="@layout/layout_skeleton_ticket" />
        <include layout="@layout/layout_skeleton_ticket" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>