<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_grid"
    tools:context=".ui.common.AnalyticsFragment">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <!-- Header Section -->
            <TextView
                android:id="@+id/tvScreenTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Analytics"
                android:textColor="?attr/colorOnSurface"
                android:textSize="28sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Summary Cards Row -->
            <LinearLayout
                android:id="@+id/llSummaryCards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/tvScreenTitle">

                <!-- Resolution Rate Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cvResolutionRate"
                    android:layout_width="0dp"
                    android:layout_height="140dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="?attr/colorRecentCardBg"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorTicketCardStroke"
                    app:strokeWidth="1dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:background="@color/dm_orange_peach"
                            app:layout_constraintTop_toTopOf="parent" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_resolution_rate"
                                    app:tint="?attr/colorTextSecondary" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:fontFamily="monospace"
                                    android:text="RATE"
                                    android:textColor="?attr/colorTextSecondary"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvResolutionRate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                tools:text="94.2%" />

                            <TextView
                                android:id="@+id/tvResolutionTrend"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="monospace"
                                android:textColor="@color/dm_mint_green"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                tools:text="+2.4% last week" />
                        </LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Average Wait Time Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cvAvgWaitTime"
                    android:layout_width="0dp"
                    android:layout_height="140dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="?attr/colorRecentCardBg"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorTicketCardStroke"
                    app:strokeWidth="1dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:background="@color/colorStatusInProgress"
                            app:layout_constraintTop_toTopOf="parent" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_avg_wait_time"
                                    app:tint="?attr/colorTextSecondary" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:fontFamily="monospace"
                                    android:text="WAIT"
                                    android:textColor="?attr/colorTextSecondary"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvAvgWaitTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                tools:text="4.2h" />

                            <TextView
                                android:id="@+id/tvWaitTimeTrend"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="monospace"
                                android:textColor="@color/dm_orange_peach"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                tools:text="-1.1h last week" />
                        </LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- 3D Category Distribution Chart -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvCategoryTrends"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="?attr/colorRecentCardBg"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorTicketCardStroke"
                app:strokeWidth="1dp"
                app:layout_constraintTop_toBottomOf="@id/llSummaryCards">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="24dp">

                    <LinearLayout
                        android:id="@+id/llTrendsHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_analytics"
                            app:tint="?attr/colorHomeSubmitButton" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="monospace"
                            android:text="CATEGORY DISTRIBUTION"
                            android:textColor="?attr/colorTextSecondary"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Chart Container -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/chartContainer"
                        android:layout_width="match_parent"
                        android:layout_height="280dp"
                        android:layout_marginTop="32dp"
                        app:layout_constraintTop_toBottomOf="@id/llTrendsHeader">

                        <!-- Numerical Labels -->
                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="wrap_content"
                            android:text="100"
                            android:textSize="8sp"
                            android:textColor="?attr/colorTextSecondary"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            android:layout_marginTop="40dp" />

                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="wrap_content"
                            android:text="50"
                            android:textSize="8sp"
                            android:textColor="?attr/colorTextSecondary"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            android:layout_marginTop="100dp"/>

                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="8sp"
                            android:textColor="?attr/colorTextSecondary"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            android:layout_marginTop="160dp" />

                        <!-- Chart Frame (Grid Lines + Bars) -->
                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="28dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent">

                            <!-- Grid Lines View -->
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="121dp"
                                android:layout_marginTop="40dp"
                                android:background="@drawable/bg_chart_grid_lines" />

                            <!-- Scrollable Bars Container -->
                            <HorizontalScrollView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scrollbars="none"
                                android:fadeScrollbars="true">

                                <LinearLayout
                                    android:id="@+id/llCategoryChart"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:gravity="bottom"
                                    android:orientation="horizontal"
                                    android:paddingBottom="100dp"
                                    android:paddingEnd="16dp"
                                    android:clipChildren="false"
                                    android:clipToPadding="false">
                                    <!-- Bars will be added dynamically -->
                                </LinearLayout>
                            </HorizontalScrollView>
                        </FrameLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Category Table Label -->
            <TextView
                android:id="@+id/tvCategoryBreakdownLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:fontFamily="monospace"
                android:text="[ DETAILED BREAKDOWN ]"
                android:textColor="?attr/colorTextSecondary"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cvCategoryTrends" />

            <!-- Category List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCategoryBreakdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                app:layout_constraintTop_toBottomOf="@id/tvCategoryBreakdownLabel"
                tools:itemCount="4"
                tools:listitem="@layout/item_category_count" />

            <!-- Loading Shimmer -->
            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmerAnalytics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/tvScreenTitle">
                <include layout="@layout/shimmer_analytics" />
            </com.facebook.shimmer.ShimmerFrameLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="32dp"
                app:layout_constraintTop_toBottomOf="@id/rvCategoryBreakdown" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
