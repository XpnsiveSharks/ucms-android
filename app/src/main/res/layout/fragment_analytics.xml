<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorSurface"
    tools:context=".ui.common.AnalyticsFragment">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/screen_padding">

            <!-- Header: Avatar -->
            <TextView
                android:id="@+id/tvAvatar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_button_pill"
                android:backgroundTint="@color/colorPrimary"
                android:gravity="center"
                android:text="@string/avatar_initials"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:id="@+id/llWelcome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_small"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="@id/tvAvatar"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/tvAvatar"
                app:layout_constraintTop_toTopOf="@id/tvAvatar">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/welcome_label"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="@color/colorTextSecondary" />

                <TextView
                    android:id="@+id/tvAdminName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="@color/colorTextPrimary"
                    android:textStyle="bold"
                    tools:text="Admin User" />
            </LinearLayout>

            <!-- Screen Title -->
            <TextView
                android:id="@+id/tvScreenTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xlarge"
                android:text="@string/analytics_title"
                android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                android:textColor="@color/colorTextPrimary"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvAvatar" />

            <!-- Shimmer for summary card -->
            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmerSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:visibility="visible"
                app:layout_constraintTop_toBottomOf="@id/tvScreenTitle">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <View android:layout_width="match_parent" android:layout_height="120dp" android:background="#E0E0E0" android:layout_marginBottom="12dp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <View android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" android:background="#E0E0E0" android:layout_marginEnd="8dp"/>
                        <View android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" android:background="#E0E0E0"/>
                    </LinearLayout>

                </LinearLayout>

            </com.facebook.shimmer.ShimmerFrameLayout>

            <!-- Card 1: Unresolved Tickets -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvUnresolved"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:visibility="gone"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/corner_radius_card"
                app:cardElevation="2dp"
                app:strokeColor="@color/colorDivider"
                app:strokeWidth="1dp"
                app:layout_constraintTop_toBottomOf="@id/tvScreenTitle">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_large">

                    <TextView
                        android:id="@+id/tvUnresolvedLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/unresolved_tickets_label"
                        android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                        android:textColor="@color/colorTextSecondary"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvTotalUnresolved"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="48sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvUnresolvedLabel"
                        tools:text="34" />

                    <!-- Resolved % badge -->
                    <LinearLayout
                        android:id="@+id/llResolvedBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_trend_badge"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        app:layout_constraintBottom_toBottomOf="@id/tvTotalUnresolved"
                        app:layout_constraintStart_toEndOf="@id/tvTotalUnresolved"
                        app:layout_constraintTop_toTopOf="@id/tvTotalUnresolved">

                        <TextView
                            android:id="@+id/tvResolvedPct"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="10sp"
                            android:textColor="@color/colorTextSecondary"
                            android:textStyle="bold"
                            tools:text="72% resolved" />
                    </LinearLayout>

                    <!-- Progress bar: pending vs in-progress -->
                    <LinearLayout
                        android:id="@+id/llProgressBar"
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:layout_marginTop="24dp"
                        android:orientation="horizontal"
                        app:layout_constraintTop_toBottomOf="@id/tvTotalUnresolved">

                        <View
                            android:id="@+id/viewPendingBar"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_badge_pending"
                            android:backgroundTint="@color/colorPrimary" />

                        <View
                            android:id="@+id/viewInProgressBar"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_badge_inprogress"
                            android:backgroundTint="@color/colorSecondary" />
                    </LinearLayout>

                    <!-- Legend -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        app:layout_constraintTop_toBottomOf="@id/llProgressBar">

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_gravity="center_vertical"
                            android:background="@drawable/bg_button_pill"
                            android:backgroundTint="@color/colorPrimary" />

                        <TextView
                            android:id="@+id/tvPendingCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:textSize="10sp"
                            android:textColor="@color/colorTextSecondary"
                            tools:text="11 Pending" />

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="24dp"
                            android:background="@drawable/bg_button_pill"
                            android:backgroundTint="@color/colorSecondary" />

                        <TextView
                            android:id="@+id/tvInProgressCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:textSize="10sp"
                            android:textColor="@color/colorTextSecondary"
                            tools:text="23 In-Progress" />
                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Most Common Concerns -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvCommonConcerns"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:visibility="gone"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/corner_radius_card"
                app:cardElevation="2dp"
                app:strokeColor="@color/colorDivider"
                app:strokeWidth="1dp"
                app:layout_constraintTop_toBottomOf="@id/cvUnresolved">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_large">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_common_concerns_header"
                        android:text="@string/most_common_concerns_label"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:textSize="12sp"
                        android:textColor="@color/colorTextPrimary"
                        android:textStyle="bold" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvCategories"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp">

                        <TextView
                            android:id="@+id/tvRank1"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:background="@drawable/bg_button_pill"
                            android:backgroundTint="@color/colorPrimary"
                            android:gravity="center"
                            android:text="1"
                            android:textColor="@color/white"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCat1Name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_toEndOf="@id/tvRank1"
                            android:text="Academic (Enrollment)"
                            android:textColor="@color/colorTextPrimary"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCat1Percent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="45%"
                            android:textColor="@color/colorTextPrimary"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:layout_below="@id/tvRank1"
                            android:layout_marginTop="12dp"
                            android:background="@color/colorSurface" />

                        <View
                            android:id="@+id/vCat1Bar"
                            android:layout_width="160dp"
                            android:layout_height="4dp"
                            android:layout_below="@id/tvRank1"
                            android:layout_marginTop="12dp"
                            android:background="@color/colorPrimary" />
                    </RelativeLayout>

                    <!-- Item 2 -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp">

                        <TextView
                            android:id="@+id/tvRank2"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:background="@drawable/bg_button_pill"
                            android:backgroundTint="@color/colorPrimary"
                            android:gravity="center"
                            android:alpha="0.6"
                            android:text="2"
                            android:textColor="@color/white"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCat2Name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_toEndOf="@id/tvRank2"
                            android:text="IT Services(Wifi/Portal)"
                            android:textColor="@color/colorTextPrimary"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCat2Percent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="30%"
                            android:textColor="@color/colorTextPrimary"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:layout_below="@id/tvRank2"
                            android:layout_marginTop="12dp"
                            android:background="@color/colorSurface" />

                        <View
                            android:id="@+id/vCat2Bar"
                            android:layout_width="100dp"
                            android:layout_height="4dp"
                            android:layout_below="@id/tvRank2"
                            android:layout_marginTop="12dp"
                            android:background="@color/colorPrimary"
                            android:alpha="0.6" />
                    </RelativeLayout>

                    <!-- Item 3 -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp">

                        <TextView
                            android:id="@+id/tvRank3"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:background="@drawable/bg_button_pill"
                            android:backgroundTint="@color/colorSecondary"
                            android:gravity="center"
                            android:text="3"
                            android:textColor="@color/white"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCat3Name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_toEndOf="@id/tvRank3"
                            android:text="Facilities(Maintenance)"
                            android:textColor="@color/colorTextPrimary"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCat3Percent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="15%"
                            android:textColor="@color/colorTextPrimary"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:layout_below="@id/tvRank3"
                            android:layout_marginTop="12dp"
                            android:background="@color/colorSurface" />

                        <View
                            android:id="@+id/vCat3Bar"
                            android:layout_width="50dp"
                            android:layout_height="4dp"
                            android:layout_below="@id/tvRank3"
                            android:layout_marginTop="12dp"
                            android:background="@color/colorSecondary" />
                    </RelativeLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 3: Category Trends -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvCategoryTrends"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/corner_radius_card"
                app:cardElevation="2dp"
                app:strokeColor="@color/colorDivider"
                app:strokeWidth="1dp"
                app:layout_constraintTop_toBottomOf="@id/cvCommonConcerns">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvTrendsLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CATEGORY TRENDS"
                        android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                        android:textColor="@color/colorTextSecondary"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- Mock Bar Chart -->
                    <LinearLayout
                        android:id="@+id/llBarChart"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:baselineAligned="false"
                        android:layout_marginTop="24dp"
                        android:orientation="horizontal"
                        android:paddingBottom="20dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvTrendsLabel">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="10dp"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="8dp"
                            android:background="@color/colorSecondary"
                            android:alpha="0.3" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="80dp"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="8dp"
                            android:background="@color/colorSecondary"
                            android:alpha="0.6" />

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="160dp"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="8dp">
                            
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@color/colorSecondary" />
                                
                            <TextView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="top|center_horizontal"
                                android:layout_marginTop="-12dp"
                                android:background="@drawable/bg_button_pill"
                                android:backgroundTint="@color/colorSecondary"
                                android:gravity="center"
                                android:text="92"
                                android:textColor="@color/white"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </FrameLayout>

                        <View
                            android:layout_width="0dp"
                            android:layout_height="80dp"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="8dp"
                            android:background="@color/colorPrimary" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="5dp"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="8dp"
                            android:background="@color/colorPrimary"
                            android:alpha="0.3" />

                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Extra padding -->
            <View
                android:layout_width="match_parent"
                android:layout_height="40dp"
                app:layout_constraintTop_toBottomOf="@id/cvCommonConcerns" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmerLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <include layout="@layout/shimmer_analytics" />

    </com.facebook.shimmer.ShimmerFrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
