<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorSurface"
    tools:context=".ui.common.AnalyticsFragment">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/screen_padding">

            <!-- Header Section -->
            <TextView
                android:id="@+id/tvSystemTelemetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="@string/system_telemetry"
                android:textColor="@color/colorElevatedSession"
                android:textSize="@dimen/text_size_label_caps"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvScreenTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/analytics"
                android:textColor="@color/colorTextPrimary"
                android:textSize="@dimen/text_size_h1"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvSystemTelemetry" />

            <!-- Summary Cards Row -->
            <LinearLayout
                android:id="@+id/llSummaryCards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xlarge"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/tvScreenTitle">

                <!-- Resolution Rate Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cvResolutionRate"
                    android:layout_width="0dp"
                    android:layout_height="140dp"
                    android:layout_marginEnd="@dimen/spacing_xsmall"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="0dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/colorDivider"
                    app:strokeWidth="1dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <!-- Top Accent -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:background="@color/colorTrendOrange"
                            app:layout_constraintTop_toTopOf="parent" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_medium">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_resolution_rate"
                                    app:tint="@color/colorTextSecondary" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:fontFamily="monospace"
                                    android:text="@string/resolution_rate"
                                    android:textColor="@color/colorTextSecondary"
                                    android:textSize="@dimen/text_size_tiny"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvResolutionRate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_small"
                                android:textColor="@color/colorTextPrimary"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                tools:text="94.2%" />

                            <TextView
                                android:id="@+id/tvResolutionTrend"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_small"
                                android:fontFamily="monospace"
                                android:textColor="@color/colorTrendGreen"
                                android:textSize="@dimen/text_size_tiny"
                                android:textStyle="bold"
                                tools:text="+2.4% from last week" />
                        </LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Average Wait Time Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cvAvgWaitTime"
                    android:layout_width="0dp"
                    android:layout_height="140dp"
                    android:layout_marginStart="@dimen/spacing_xsmall"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="0dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/colorDivider"
                    app:strokeWidth="1dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <!-- Top Accent -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:background="@color/colorPriorityHigh"
                            app:layout_constraintTop_toTopOf="parent" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_medium">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_avg_wait_time"
                                    app:tint="@color/colorTextSecondary" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:fontFamily="monospace"
                                    android:text="@string/avg_wait_time"
                                    android:textColor="@color/colorTextSecondary"
                                    android:textSize="@dimen/text_size_tiny"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvAvgWaitTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_small"
                                android:textColor="@color/colorTextPrimary"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                tools:text="4.2h" />

                            <TextView
                                android:id="@+id/tvWaitTimeTrend"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_small"
                                android:fontFamily="monospace"
                                android:textColor="@color/colorTrendOrange"
                                android:textSize="@dimen/text_size_tiny"
                                android:textStyle="bold"
                                tools:text="-1.1h from last week" />
                        </LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Ticket Volume Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvTicketVolume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xlarge"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/colorDivider"
                app:strokeWidth="1dp"
                app:layout_constraintTop_toBottomOf="@id/llSummaryCards">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_xlarge">

                    <LinearLayout
                        android:id="@+id/llVolumeHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_ticket_volume" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="monospace"
                            android:text="@string/ticket_volume_7_days"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="@dimen/text_size_tiny"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Mock Bar Chart -->
                    <LinearLayout
                        android:id="@+id/llMockChart"
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        android:layout_marginTop="@dimen/spacing_xlarge"
                        android:gravity="bottom"
                        android:orientation="horizontal"
                        app:layout_constraintTop_toBottomOf="@id/llVolumeHeader">

                        <!-- Bars with days -->
                        <include layout="@layout/item_chart_bar" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                        <include layout="@layout/item_chart_bar" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                        <include layout="@layout/item_chart_bar" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                        <include layout="@layout/item_chart_bar" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                        <include layout="@layout/item_chart_bar" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                        <include layout="@layout/item_chart_bar" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                        <include layout="@layout/item_chart_bar" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />

                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Category Breakdown Section -->
            <TextView
                android:id="@+id/tvCategoryBreakdownLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xlarge"
                android:fontFamily="monospace"
                android:text="@string/category_breakdown_label"
                android:textColor="@color/colorTextSecondary"
                android:textSize="@dimen/text_size_tiny"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cvTicketVolume" />

            <!-- Category List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCategoryBreakdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:nestedScrollingEnabled="false"
                app:layout_constraintTop_toBottomOf="@id/tvCategoryBreakdownLabel"
                tools:itemCount="4"
                tools:listitem="@layout/item_category_count" />

            <!-- Loading Shimmer -->
            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmerAnalytics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/tvScreenTitle">
                <include layout="@layout/shimmer_analytics" />
            </com.facebook.shimmer.ShimmerFrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>