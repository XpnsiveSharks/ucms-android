<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_grid"
    tools:context=".ui.common.AnalyticsFragment">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <!-- Header Section -->
            <TextView
                android:id="@+id/tvScreenTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="System Insights"
                android:textColor="?attr/colorOnSurface"
                android:textSize="28sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvScreenSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Monitor concern resolution and trends"
                android:textColor="?attr/colorTextSecondary"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvScreenTitle" />

            <!-- Summary Cards Row (Rate & Wait) -->
            <LinearLayout
                android:id="@+id/llTopMetrics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/tvScreenSubtitle">

                <!-- Resolution Rate -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="?attr/colorRecentCardBg"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorTicketCardStroke"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RESOLVED"
                            android:fontFamily="monospace"
                            android:textColor="?attr/colorTextSecondary"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tvResolutionRate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            tools:text="92.5%" />
                        <TextView
                            android:id="@+id/tvResolutionTrend"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/dm_mint_green"
                            android:textSize="10sp"
                            tools:text="+2.4% vs last week" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Average Response -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="?attr/colorRecentCardBg"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorTicketCardStroke"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AVG RESPONSE"
                            android:fontFamily="monospace"
                            android:textColor="?attr/colorTextSecondary"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tvAvgWaitTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            tools:text="4.2h" />
                        <TextView
                            android:id="@+id/tvWaitTimeTrend"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/dm_orange_peach"
                            android:textSize="10sp"
                            tools:text="-1.1h vs last week" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Concern Volume Timeline (Area/Line style using bars) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvTimeline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="?attr/colorRecentCardBg"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorTicketCardStroke"
                app:strokeWidth="1dp"
                app:layout_constraintTop_toBottomOf="@id/llTopMetrics">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CONCERN VOLUME (7D)"
                        android:fontFamily="monospace"
                        android:textColor="?attr/colorTextSecondary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                    
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        android:layout_marginTop="24dp">
                        
                        <!-- Grid Lines -->
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorTicketCardStroke" app:layout_constraintTop_toTopOf="parent" />
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorTicketCardStroke" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorTicketCardStroke" app:layout_constraintBottom_toBottomOf="parent" />

                        <LinearLayout
                            android:id="@+id/llTimelineChart"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="bottom"
                            android:orientation="horizontal"
                            android:paddingHorizontal="8dp">
                            <!-- Dynamic bars representing daily volume -->
                        </LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Category Distribution (3D Block Chart) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvCategoryTrends"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="?attr/colorRecentCardBg"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorTicketCardStroke"
                app:strokeWidth="1dp"
                app:layout_constraintTop_toBottomOf="@id/cvTimeline">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CONCERN BY CATEGORY"
                        android:fontFamily="monospace"
                        android:textColor="?attr/colorTextSecondary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="240dp"
                        android:layout_marginTop="24dp">
                        
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="24dp">
                            
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginBottom="80dp"
                                android:background="@drawable/bg_chart_grid_lines" />

                            <HorizontalScrollView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scrollbars="none">
                                <LinearLayout
                                    android:id="@+id/llCategoryChart"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:gravity="bottom"
                                    android:orientation="horizontal"
                                    android:paddingBottom="80dp"
                                    android:paddingEnd="16dp"
                                    android:clipChildren="false" />
                            </HorizontalScrollView>
                        </FrameLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Status Distribution Overview -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="?attr/colorRecentCardBg"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorTicketCardStroke"
                app:strokeWidth="1dp"
                app:layout_constraintTop_toBottomOf="@id/cvCategoryTrends">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="STATUS DISTRIBUTION"
                        android:fontFamily="monospace"
                        android:textColor="?attr/colorTextSecondary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/llStatusDistribution"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:orientation="vertical">
                        <!-- Dynamic status bars will be added here -->
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Detailed Table Section -->
            <TextView
                android:id="@+id/tvDetailedLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Breakdown Details"
                android:textColor="?attr/colorOnSurface"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cvStatus" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCategoryBreakdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                app:layout_constraintTop_toBottomOf="@id/tvDetailedLabel"
                tools:itemCount="3"
                tools:listitem="@layout/item_category_count" />

            <View
                android:layout_width="match_parent"
                android:layout_height="40dp"
                app:layout_constraintTop_toBottomOf="@id/rvCategoryBreakdown" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Loading Overlay -->
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmerAnalytics"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">
        <include layout="@layout/shimmer_analytics" />
    </com.facebook.shimmer.ShimmerFrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
