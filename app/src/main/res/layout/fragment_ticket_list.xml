<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_grid"
    android:padding="@dimen/screen_padding">

    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ticket Directory"
                android:textColor="?attr/colorOnSurface"
                android:textSize="28sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFilter"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="0dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:iconPadding="0dp"
                app:iconGravity="textStart"
                android:contentDescription="@string/filter"
                app:icon="@drawable/ic_filter"
                app:iconTint="?attr/colorOnSurface"
                app:strokeColor="?attr/colorTicketCardStroke"
                app:cornerRadius="12dp" />
        </LinearLayout>

        <!-- Filter Tabs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tabAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ALL LOGS"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:textStyle="bold"
                android:textColor="?attr/colorHomeSubmitButton"
                android:paddingBottom="8dp"
                android:layout_marginEnd="24dp" />

            <TextView
                android:id="@+id/tabInProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IN PROGRESS"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:textColor="?attr/colorTextSecondary"
                android:paddingBottom="8dp"
                android:layout_marginEnd="24dp" />

            <TextView
                android:id="@+id/tabResolved"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RESOLVED"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:textColor="?attr/colorTextSecondary"
                android:paddingBottom="8dp" />

        </LinearLayout>

        <!-- Tab Indicator Line -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorTicketCardStroke">

            <View
                android:id="@+id/tabIndicator"
                android:layout_width="60dp"
                android:layout_height="2dp"
                android:layout_alignParentBottom="true"
                android:background="?attr/colorHomeSubmitButton" />
        </RelativeLayout>

    </LinearLayout>

    <!-- SwipeRefreshLayout wrapping content area -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Loading Skeleton -->
            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmerLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include layout="@layout/layout_skeleton_ticket" />
                    <include layout="@layout/layout_skeleton_ticket" />
                    <include layout="@layout/layout_skeleton_ticket" />

                </LinearLayout>

            </com.facebook.shimmer.ShimmerFrameLayout>

            <!-- Error State -->
            <LinearLayout
                android:id="@+id/layoutError"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Something went wrong"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRetry"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Retry"
                    android:textAllCaps="false"
                    app:cornerRadius="50dp"
                    app:strokeColor="?attr/colorHomeSubmitButton"
                    android:textColor="?attr/colorHomeSubmitButton" />

            </LinearLayout>

            <!-- Ticket list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTickets"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="16dp"
                android:background="@android:color/transparent"
                android:visibility="gone"
                android:paddingBottom="88dp"
                android:clipToPadding="false"
                tools:listitem="@layout/item_recent_ticket" />

            <!-- Empty state -->
            <TextView
                android:id="@+id/tvEmptyState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/no_tickets_yet"
                android:fontFamily="monospace"
                android:textColor="?attr/colorTextSecondary"
                android:visibility="gone"
                tools:visibility="visible" />

        </FrameLayout>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Submit ticket button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnSubmitTicket"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="@string/submit_ticket"
        android:src="@drawable/ic_add"
        app:backgroundTint="?attr/colorHomeSubmitButton"
        app:tint="@color/white"
        app:elevation="6dp"
        app:borderWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
