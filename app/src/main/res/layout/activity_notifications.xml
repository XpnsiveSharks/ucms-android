<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorHomeGridBg">

    <!-- Modal Container -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="24dp"
        app:cardBackgroundColor="?attr/colorRecentCardBg"
        app:cardCornerRadius="12dp"
        app:cardElevation="16dp"
        app:strokeWidth="1dp"
        app:strokeColor="?attr/colorTicketCardStroke"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Top Accent Line -->
            <View
                android:id="@+id/viewAccent"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:background="?attr/colorHomeSubmitButton"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Header -->
            <LinearLayout
                android:id="@+id/layoutHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp"
                app:layout_constraintTop_toBottomOf="@id/viewAccent">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_notifications"
                    app:tint="?attr/colorHomeSubmitButton" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.2"
                    android:text="NOTIFICATIONS"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/btnClose"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/ic_close"
                    app:tint="?attr/colorTextSecondary" />
            </LinearLayout>

            <View
                android:id="@+id/headerDivider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/colorTicketCardStroke"
                app:layout_constraintTop_toBottomOf="@id/layoutHeader" />

            <!-- Notification list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvNotifications"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:clipToPadding="false"
                app:layout_constraintBottom_toTopOf="@id/layoutFooter"
                app:layout_constraintTop_toBottomOf="@id/headerDivider"
                tools:listitem="@layout/item_notification" />

            <!-- Loading -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:indeterminateTint="?attr/colorHomeSubmitButton"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/rvNotifications"
                app:layout_constraintEnd_toEndOf="@id/rvNotifications"
                app:layout_constraintStart_toStartOf="@id/rvNotifications"
                app:layout_constraintTop_toTopOf="@id/rvNotifications" />

            <!-- Empty state -->
            <TextView
                android:id="@+id/tvEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="No notifications yet"
                android:textColor="?attr/colorTextSecondary"
                android:textSize="14sp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/rvNotifications"
                app:layout_constraintEnd_toEndOf="@id/rvNotifications"
                app:layout_constraintStart_toStartOf="@id/rvNotifications"
                app:layout_constraintTop_toTopOf="@id/rvNotifications" />

            <!-- Footer -->
            <LinearLayout
                android:id="@+id/layoutFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/colorHomeGridBg"
                android:gravity="center"
                android:paddingVertical="16dp"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:id="@+id/btnMarkAllRead"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.1"
                    android:text="MARK ALL AS READ"
                    android:textColor="?attr/colorHomeSubmitButton"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
