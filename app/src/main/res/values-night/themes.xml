<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (night). -->
    <style name="Base.Theme.Ucmsandroid" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary (Orange) -->
        <item name="colorPrimary">@color/colorLoginButtonDark</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Surface & Background -->
        <item name="colorSurface">@color/colorSurfaceDark</item>
        <item name="colorOnSurface">@color/colorDirtyWhite</item>
        <item name="android:colorBackground">@color/colorSurfaceDark</item>

        <!-- Login Attributes -->
        <item name="colorLoginButton">@color/colorLoginButtonDark</item>
        <item name="colorInputBackground">@color/colorInputBackgroundDark</item>
        <item name="colorInputText">@color/white</item>
        <item name="colorLabelText">@color/white</item>

        <!-- Bottom Nav Customization -->
        <item name="colorContainer">@android:color/transparent</item>
        <item name="colorControlNormal">#FFFFFF</item>
        <item name="bottomNavigationStyle">@style/Widget.App.BottomNavigationView</item>
    </style>

    <style name="Widget.App.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="itemActiveIndicatorStyle">@null</item>
        <item name="backgroundTint">@color/colorSurfaceDark</item>
        <item name="android:background">@color/colorSurfaceDark</item>
    </style>

    <style name="Theme.Ucmsandroid" parent="Base.Theme.Ucmsandroid" />
</resources>
