<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Ucmsandroid" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary (Orange) -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Surface & Background -->
        <item name="colorSurface">@color/colorSurface</item>
        <item name="android:colorBackground">@color/colorSurface</item>

        <!-- Bottom Nav Customization -->
        <item name="colorContainer">@android:color/transparent</item>
        <item name="colorControlNormal">#000000</item>
    </style>

    <style name="Theme.Ucmsandroid" parent="Base.Theme.Ucmsandroid" />
</resources>
